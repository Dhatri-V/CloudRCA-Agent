{
  "$defs": {
    "CausalEdge": {
      "additionalProperties": false,
      "properties": {
        "cause_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Cause Id",
          "type": "string"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "effect_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Effect Id",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "cause_id",
        "effect_id",
        "summary",
        "confidence",
        "evidence"
      ],
      "title": "CausalEdge",
      "type": "object"
    },
    "ComponentKind": {
      "enum": [
        "host",
        "vm",
        "node",
        "pod",
        "database",
        "service"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "kind",
        "layer"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "level"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "event",
        "topology",
        "finding",
        "metric",
        "log"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "reference_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "JsonValue": {},
    "Layer": {
      "enum": [
        "host_hypervisor",
        "vm_guest_os",
        "database"
      ],
      "title": "Layer",
      "type": "string"
    },
    "ModelRuntimeProvenance": {
      "additionalProperties": false,
      "properties": {
        "harness": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Harness",
          "type": "string"
        },
        "harness_version": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Harness Version"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "model",
        "harness"
      ],
      "title": "ModelRuntimeProvenance",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "record_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "observed",
        "augmented",
        "synthetic"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "RootCauseHypothesis": {
      "additionalProperties": false,
      "properties": {
        "component": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComponentRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "layer",
        "confidence",
        "evidence"
      ],
      "title": "RootCauseHypothesis",
      "type": "object"
    },
    "TimelineEntry": {
      "additionalProperties": false,
      "properties": {
        "event_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Event Ids",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        }
      },
      "required": [
        "timestamp",
        "summary",
        "event_ids"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "$id": "https://cloudrca.dev/schemas/v1.0.0/rca-report.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alternative_hypotheses": {
      "items": {
        "$ref": "#/$defs/RootCauseHypothesis"
      },
      "title": "Alternative Hypotheses",
      "type": "array"
    },
    "causal_chain": {
      "items": {
        "$ref": "#/$defs/CausalEdge"
      },
      "minItems": 1,
      "title": "Causal Chain",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/Confidence"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "incident_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "probable_root_cause": {
      "minLength": 1,
      "title": "Probable Root Cause",
      "type": "string"
    },
    "root_cause_component": {
      "$ref": "#/$defs/ComponentRef"
    },
    "root_cause_layer": {
      "$ref": "#/$defs/Layer"
    },
    "runtime": {
      "$ref": "#/$defs/ModelRuntimeProvenance"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/TimelineEntry"
      },
      "minItems": 1,
      "title": "Timeline",
      "type": "array"
    },
    "uncertainty": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Uncertainty"
    }
  },
  "required": [
    "incident_id",
    "probable_root_cause",
    "root_cause_layer",
    "root_cause_component",
    "timeline",
    "causal_chain",
    "evidence",
    "confidence",
    "runtime"
  ],
  "title": "RCAReport",
  "type": "object"
}
