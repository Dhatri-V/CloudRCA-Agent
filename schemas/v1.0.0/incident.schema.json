{
  "$defs": {
    "ComponentKind": {
      "enum": [
        "host",
        "vm",
        "node",
        "pod",
        "database",
        "service"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "kind",
        "layer"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "score",
        "level"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "EvidenceKind": {
      "enum": [
        "event",
        "topology",
        "finding",
        "metric",
        "log"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "reference_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "component_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Component Ids",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "event_ids": {
          "items": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "title": "Event Ids",
          "type": "array"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceReference"
          },
          "minItems": 1,
          "title": "Evidence",
          "type": "array"
        },
        "finding_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Finding Id",
          "type": "string"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "suspected_problem": {
          "minLength": 1,
          "title": "Suspected Problem",
          "type": "string"
        },
        "time_window": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeWindow"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "finding_id",
        "layer",
        "summary",
        "suspected_problem",
        "confidence",
        "evidence"
      ],
      "title": "Finding",
      "type": "object"
    },
    "IncidentStatus": {
      "enum": [
        "open",
        "investigating",
        "resolved"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "JsonValue": {},
    "Layer": {
      "enum": [
        "host_hypervisor",
        "vm_guest_os",
        "database"
      ],
      "title": "Layer",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "record_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "observed",
        "augmented",
        "synthetic"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "$id": "https://cloudrca.dev/schemas/v1.0.0/incident.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_components": {
      "items": {
        "$ref": "#/$defs/ComponentRef"
      },
      "minItems": 1,
      "title": "Affected Components",
      "type": "array"
    },
    "affected_layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "minItems": 1,
      "title": "Affected Layers",
      "type": "array",
      "uniqueItems": true
    },
    "event_ids": {
      "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Event Ids",
      "type": "array"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/Finding"
      },
      "minItems": 1,
      "title": "Findings",
      "type": "array"
    },
    "incident_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Incident Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus",
      "default": "open"
    },
    "time_window": {
      "$ref": "#/$defs/TimeWindow"
    }
  },
  "required": [
    "incident_id",
    "time_window",
    "affected_layers",
    "affected_components",
    "event_ids",
    "findings"
  ],
  "title": "Incident",
  "type": "object"
}
