{
  "$defs": {
    "ComponentKind": {
      "enum": [
        "host",
        "vm",
        "node",
        "pod",
        "database",
        "service"
      ],
      "title": "ComponentKind",
      "type": "string"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Component Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ComponentKind"
        },
        "layer": {
          "$ref": "#/$defs/Layer"
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "component_id",
        "kind",
        "layer"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "EvidenceKind": {
      "enum": [
        "event",
        "topology",
        "finding",
        "metric",
        "log"
      ],
      "title": "EvidenceKind",
      "type": "string"
    },
    "EvidenceReference": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "evidence_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Evidence Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EvidenceKind"
        },
        "provenance": {
          "anyOf": [
            {
              "$ref": "#/$defs/Provenance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reference_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Reference Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "kind",
        "reference_id"
      ],
      "title": "EvidenceReference",
      "type": "object"
    },
    "JsonValue": {},
    "Layer": {
      "enum": [
        "host_hypervisor",
        "vm_guest_os",
        "database"
      ],
      "title": "Layer",
      "type": "string"
    },
    "Provenance": {
      "additionalProperties": false,
      "properties": {
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "kind": {
          "$ref": "#/$defs/ProvenanceKind"
        },
        "record_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Id"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "source"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "ProvenanceKind": {
      "enum": [
        "observed",
        "augmented",
        "synthetic"
      ],
      "title": "ProvenanceKind",
      "type": "string"
    },
    "RelationshipType": {
      "enum": [
        "runs_on",
        "connects_to",
        "depends_on"
      ],
      "title": "RelationshipType",
      "type": "string"
    },
    "TimeWindow": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "format": "date-time",
          "title": "End",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "start": {
          "format": "date-time",
          "title": "Start",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "TimeWindow",
      "type": "object"
    }
  },
  "$id": "https://cloudrca.dev/schemas/v1.0.0/topology-relationship.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceReference"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "relationship_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Relationship Id",
      "type": "string"
    },
    "relationship_type": {
      "$ref": "#/$defs/RelationshipType"
    },
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ComponentRef"
    },
    "target": {
      "$ref": "#/$defs/ComponentRef"
    },
    "validity": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimeWindow"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "relationship_id",
    "source",
    "target",
    "relationship_type",
    "provenance",
    "evidence"
  ],
  "title": "TopologyRelationship",
  "type": "object"
}
