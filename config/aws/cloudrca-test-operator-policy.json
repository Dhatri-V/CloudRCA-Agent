{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartStopThisInstanceOnly",
      "Effect": "Allow",
      "Action": ["ec2:StartInstances", "ec2:StopInstances"],
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/${INSTANCE_ID}"
    },
    {
      "Sid": "SshRuleOnThisSecurityGroupOnly",
      "Effect": "Allow",
      "Action": ["ec2:AuthorizeSecurityGroupIngress", "ec2:RevokeSecurityGroupIngress"],
      "Resource": "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:security-group/${SECURITY_GROUP_ID}"
    },
    {
      "Sid": "ReadOnlyChecksNeededByTheSuite",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstanceStatus", "ec2:DescribeInstanceAttribute", "ec2:DescribeSecurityGroupRules"],
      "Resource": "*"
    },
    {
      "Sid": "NeverDestroyOrReconfigure",
      "Effect": "Deny",
      "Action": [
        "ec2:TerminateInstances",
        "ec2:RunInstances",
        "ec2:ModifyInstanceAttribute",
        "ec2:ModifyInstanceCreditSpecification",
        "ec2:DeleteSecurityGroup",
        "ec2:CreateSecurityGroup",
        "iam:*"
      ],
      "Resource": "*"
    }
  ]
}
