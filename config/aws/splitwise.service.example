# systemd unit for splitwise-backend on EC2 (example; copy to /etc/systemd/system/splitwise.service and adjust paths).
# The app writes CloudRCA JSON lines to SPLITWISE_LOG_FILE; scripts/collect_splitwise_incident.py copies that file.
# Uses the checkout's existing .venv (python -m venv .venv). Binds to localhost only: reach it through an SSH tunnel (ssh -L 8000:127.0.0.1:8000 splitwise-ec2), not a public port.
[Unit]
Description=Splitwise API (uvicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/splitwise-backend
# systemd creates /var/log/splitwise owned by User, so the app can write its log there.
LogsDirectory=splitwise
LogsDirectoryMode=0750
Environment=SPLITWISE_LOG_FILE=/var/log/splitwise/app.jsonl
Environment=SPLITWISE_HEARTBEAT_SECONDS=60
Environment=SPLITWISE_SERVICE_NAME=splitwise-api
Environment=SPLITWISE_DATABASE_ID=splitwise-sqlite
ExecStart=/home/ec2-user/splitwise-backend/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure

[Install]
WantedBy=multi-user.target
