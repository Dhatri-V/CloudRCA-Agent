# Copy this file to .env and adjust paths for your machine.
# Supported profiles: development, test, demo
CLOUDRCA_PROFILE=development
CLOUDRCA_DATA_DIR=./data
CLOUDRCA_KNOWLEDGE_DIR=./knowledge
CLOUDRCA_JCODE_BINARY=jcode

# Qwen specialist runtime. Use an installed model name; do not put secrets here.
CLOUDRCA_QWEN_PROVIDER_PROFILE=cloudrca-qwen
CLOUDRCA_QWEN_BASE_URL=http://localhost:11434/v1
CLOUDRCA_QWEN_MODEL=qwen3
CLOUDRCA_QWEN_API_KEY_ENV=
CLOUDRCA_SPECIALIST_TIMEOUT_SECONDS=60
CLOUDRCA_SPECIALIST_MAX_EVENTS=100
CLOUDRCA_SPECIALIST_MAX_PROMPT_CHARACTERS=50000
CLOUDRCA_SPECIALIST_MAX_REPAIR_ATTEMPTS=1
CLOUDRCA_SPECIALIST_PROMPT_VERSION=specialist-v1

# GLM main RCA runtime. Set ZHIPU_API_KEY in your shell, never in this file.
CLOUDRCA_GLM_PROVIDER_PROFILE=zai
CLOUDRCA_GLM_BASE_URL=https://api.z.ai/api/paas/v4
CLOUDRCA_GLM_MODEL=glm-5.3
CLOUDRCA_GLM_API_KEY_ENV=ZHIPU_API_KEY
CLOUDRCA_MAIN_RCA_TIMEOUT_SECONDS=60
CLOUDRCA_MAIN_RCA_MAX_EVENTS=100
CLOUDRCA_MAIN_RCA_MAX_PROMPT_CHARACTERS=50000
CLOUDRCA_MAIN_RCA_MAX_REPAIR_ATTEMPTS=1
CLOUDRCA_MAIN_RCA_PROMPT_VERSION=main-rca-v1
