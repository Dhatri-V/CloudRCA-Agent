# Copy this file to .env and adjust paths for your machine.
# Supported profiles: development, test, demo
CLOUDRCA_PROFILE=development
CLOUDRCA_DATA_DIR=./data
CLOUDRCA_KNOWLEDGE_DIR=./knowledge
CLOUDRCA_JCODE_BINARY=jcode
CLOUDRCA_API_DATABASE=./data/cloudrca.sqlite3
CLOUDRCA_BACKEND_URL=http://127.0.0.1:8000

# Qwen specialist runtime. Use an installed model name; do not put secrets here.
CLOUDRCA_QWEN_PROVIDER_PROFILE=cloudrca-qwen
CLOUDRCA_QWEN_BASE_URL=http://localhost:11434/v1
CLOUDRCA_QWEN_MODEL=qwen3
CLOUDRCA_QWEN_API_KEY_ENV=
CLOUDRCA_SPECIALIST_TIMEOUT_SECONDS=60
CLOUDRCA_SPECIALIST_MAX_EVENTS=100
CLOUDRCA_SPECIALIST_MAX_PROMPT_CHARACTERS=50000
CLOUDRCA_SPECIALIST_MAX_REPAIR_ATTEMPTS=1
CLOUDRCA_SPECIALIST_PROMPT_VERSION=specialist-v1

# Main RCA runtime. CLOUDRCA_GLM_* names are historical; any OpenAI-compatible provider works.
# Default: OpenRouter free model. Put OPENROUTER_API_KEY=... in your gitignored .env (never here).
# A key with a $0 credit limit can call ":free" models but never paid ones.
CLOUDRCA_GLM_PROVIDER_PROFILE=cloudrca-openrouter
CLOUDRCA_GLM_BASE_URL=https://openrouter.ai/api/v1
CLOUDRCA_GLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
CLOUDRCA_GLM_API_KEY_ENV=OPENROUTER_API_KEY
# Optional alternative: Z.AI GLM-5.3 (paid; needs ZHIPU_API_KEY). Uncomment these and comment the four lines above.
# CLOUDRCA_GLM_PROVIDER_PROFILE=cloudrca-glm
# CLOUDRCA_GLM_BASE_URL=https://api.z.ai/api/paas/v4
# CLOUDRCA_GLM_MODEL=glm-5.3
# CLOUDRCA_GLM_API_KEY_ENV=ZHIPU_API_KEY
CLOUDRCA_MAIN_RCA_TIMEOUT_SECONDS=180
CLOUDRCA_MAIN_RCA_MAX_EVENTS=100
CLOUDRCA_MAIN_RCA_MAX_PROMPT_CHARACTERS=50000
CLOUDRCA_MAIN_RCA_MAX_REPAIR_ATTEMPTS=1
CLOUDRCA_MAIN_RCA_PROMPT_VERSION=main-rca-v2

# Production RCA pipeline (run by cloudrca-api for each analysis job).
CLOUDRCA_ROUTING_CONFIG=./config/routing/aiops2025.yaml
CLOUDRCA_PIPELINE_MAX_INCIDENTS=10
